<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
  	<EnableHarmony>true</EnableHarmony>
	  <RootNamespace>BetterMinecartMenu</RootNamespace>
    <Version>1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <PackageReference Include="PropertyChanged.SourceGenerator" Version="1.1.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ContentPacks Include="BetterMinecartMenu_CP" Version="$(Version)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Views/*.sml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Views/*.sml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
