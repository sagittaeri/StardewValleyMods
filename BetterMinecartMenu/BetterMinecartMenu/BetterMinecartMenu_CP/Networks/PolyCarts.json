{
    "$schema": "https://smapi.io/schemas/content-patcher.json",
    "Changes": [
        // Frontier farm integration
        {
            "Action": "EditData",
            "Target": "Sagittaeri.BetterMinecartMenu/MinecartNetworkEdits",
            "TargetField": ["Default", "AppendDestinations"],
            "Entries": {
                "FlashShifter.FrontierFarm_Right": null,
                "FlashShifter.FrontierFarm_Middle": null,
                "FlashShifter.FrontierFarm_Left": null
            },
            "When": { "HasMod |contains=flashshifter.FrontierFarm": true }
        },
        {
            "Action": "EditData",
            "Target": "Sagittaeri.BetterMinecartMenu/MinecartNetworkEdits",
            "Entries": {
                "FrontierFarm": {
                    "RemoveNetwork": true,
                    "RedirectNetwork": "Outskirts"
                }
            },
            "When": { "HasMod |contains=flashshifter.FrontierFarm": true }
        },
        // RSV integration
        {
            "Action": "EditData",
            "Target": "Sagittaeri.BetterMinecartMenu/MinecartNetworkEdits",
            "Entries": {
                "RidgeSide": {
                    "RemoveNetwork": true,
                    "RedirectNetwork": "RSV.MinecartNetwork"
                }
            },
            "When": { "HasMod |contains=Rafseazz.RSVCP": true }
        },
        {
            "Action": "EditData",
            "Target": "Sagittaeri.BetterMinecartMenu/MinecartNetworkEdits",
            "TargetField": ["RSV.MinecartNetwork", "AppendDestinations"],
            "Entries": {
                "Polydot.PolyCarts_RSV_CableCar_Bottom": "Polydot.PolyCarts_RSV_CableCar_Bottom",
                "Polydot.PolyCarts_RSV_CableCar_Top": "Polydot.PolyCarts_RSV_CableCar_Top",
                "Polydot.PolyCarts_RSV_Heaps": "Polydot.PolyCarts_RSV_Heaps",
                "Polydot.PolyCarts_RSV_Nightingale": "Polydot.PolyCarts_RSV_Nightingale",
                "Polydot.PolyCarts_RSV_Greenhouse": "Polydot.PolyCarts_RSV_Greenhouse",
                "Polydot.PolyCarts_RSV_LogCabin": "Polydot.PolyCarts_RSV_LogCabin",
                "Polydot.PolyCarts_RSV_Hike": "Polydot.PolyCarts_RSV_Hike",
                "Polydot.PolyCarts_RSV_Falls": "Polydot.PolyCarts_RSV_Falls",
                "Polydot.PolyCarts_RSV_Pond": "Polydot.PolyCarts_RSV_Pond",
                "Polydot.PolyCarts_RSV_Ridge_East": "Polydot.PolyCarts_RSV_Ridge_East",
                "Polydot.PolyCarts_RSV_Ridge_West": "Polydot.PolyCarts_RSV_Ridge_West",
                "Polydot.PolyCarts_RSV_SummitFarm_East": "Polydot.PolyCarts_RSV_SummitFarm_East",
                "Polydot.PolyCarts_RSV_SummitFarm_West": "Polydot.PolyCarts_RSV_SummitFarm_West"
            },
            "When": { "HasMod |contains=Rafseazz.RSVCP": true }
        },
        {
            "Action": "EditData",
            "Target": "Sagittaeri.BetterMinecartMenu/MinecartNetworkEdits",
            "TargetField": ["RSV.MinecartNetwork", "RemoveDestinations"],
            "Entries": {
                "RSV_CableCar": "RSV_CableCar",
                "RSV_Heaps": "RSV_Heaps",
                "RSV_Nightingale": "RSV_Nightingale",
                "RSV_Greenhouse": "RSV_Greenhouse",
                "RSV_EastSummit": "RSV_EastSummit",
                "RSV_WestSummit": "RSV_WestSummit"
            },
            "When": { "HasMod |contains=Rafseazz.RSVCP": true }
        },
        // ES integration
        {
            "Action": "EditData",
            "Target": "Sagittaeri.BetterMinecartMenu/MinecartNetworkEdits",
            "TargetField": ["EastScarp", "AppendDestinations"],
            "Entries": {
                "Polydot.PolyCarts_ScarpCrossing": "Polydot.PolyCarts_ScarpCrossing",
                "Polydot.PolyCarts_ScarpVillage": "Polydot.PolyCarts_ScarpVillage",
                "Polydot.PolyCarts_DeepMountains_South": "Polydot.PolyCarts_DeepMountains_South",
                "Polydot.PolyCarts_DeepMountains_West": "Polydot.PolyCarts_DeepMountains_West",
                "Polydot.PolyCarts_UnderScarp": "Polydot.PolyCarts_UnderScarp",
                "Polydot.PolyCarts_MeadowFarm": "Polydot.PolyCarts_MeadowFarm",
                "Polydot.PolyCarts_Orchard": "Polydot.PolyCarts_Orchard"
                //"Polydot.PolyCarts_Town_East": "Polydot.PolyCarts_Town_East"
            },
            "When": { "HasMod |contains=Lemurkat.EastScarp": true }
        },
        // Misc
        {
            "Action": "EditData",
            "Target": "Sagittaeri.BetterMinecartMenu/MinecartNetworkEdits",
            "TargetField": ["Outskirts", "AppendDestinations"],
            "Entries": {
                "Polydot.PolyCarts_Expa": "Polydot.PolyCarts_Expa",
                "Polydot.PolyCarts_Forest_North": "Polydot.PolyCarts_Forest_North",
                "Polydot.PolyCarts_Forest_East": "Polydot.PolyCarts_Forest_East",
                "Polydot.PolyCarts_Forest_West": "Polydot.PolyCarts_Forest_West",
                "Polydot.PolyCarts_ForestWest_North": "Polydot.PolyCarts_ForestWest_North",
                "Polydot.PolyCarts_ForestWest_East": "Polydot.PolyCarts_ForestWest_East",
                "Polydot.PolyCarts_ForestWest_South": "Polydot.PolyCarts_ForestWest_South",
                "Polydot.PolyCarts_ForestWest_West": "Polydot.PolyCarts_ForestWest_West",
                "Polydot.PolyCarts_Secret_Woods": "Polydot.PolyCarts_Secret_Woods",
                "Polydot.PolyCarts_Desert_North": "Polydot.PolyCarts_Desert_North",
                "Polydot.PolyCarts_Desert_South": "Polydot.PolyCarts_Desert_South",
                "Polydot.PolyCarts_GingerIsland_North": "Polydot.PolyCarts_GingerIsland_North",
                "Polydot.PolyCarts_GingerIsland_East": "Polydot.PolyCarts_GingerIsland_East",
                "Polydot.PolyCarts_GingerIsland_South": "Polydot.PolyCarts_GingerIsland_South",
                "Polydot.PolyCarts_GingerIsland_West": "Polydot.PolyCarts_GingerIsland_West"
            }
        }
    ]
}
